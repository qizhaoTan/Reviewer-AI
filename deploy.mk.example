# 复制为 deploy.mk（已被 .gitignore 忽略）并填入自己的分发目标。
#
# 每一项是一个 scp 目标，形如 user@host:/path/ ；多个用空格分隔。
# 需要非标端口等额外参数时用 SCP_FLAGS（对所有目标生效）。

# make dist：把 linux + windows 版推到共享目录
DIST_TARGETS   := user@example.internal:/data/share/tools/bin/.

# make upload：把 linux 版推到各台机器的 PATH 目录
UPLOAD_TARGETS := user@host-a.example.internal:/usr/local/bin/cr \
                  user@host-b.example.internal:/usr/local/bin/cr

# SCP_FLAGS   := -P 2222
